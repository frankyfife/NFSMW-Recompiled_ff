// IDI_ICON1 is the id Qt uses as the default window icon on Windows.
IDI_ICON1 ICON "launcher.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "NFS Most Wanted Recompiled - Launcher"
      VALUE "ProductName", "NFS Most Wanted Recompiled"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
